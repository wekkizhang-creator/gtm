PORT=4000
DB_PATH=server/data/app.db

# Optional production subpath deployment, for example:
# VITE_APP_BASE=/efficiency-list/
# VITE_API_BASE=/efficiency-list/api

# Auth tokens and identifier hashes. Use long random values in production.
AUTH_TOKEN_SECRET=change-me
AUTH_IDENTIFIER_SECRET=change-me-too
AUTH_COOKIE_SECURE=false

# Email verification codes are delivered through a real SMTP provider.
# For implicit TLS providers such as port 465, set SMTP_SECURE=true.
# For STARTTLS providers such as port 587, set SMTP_STARTTLS=true.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_HELO=localhost
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password-or-app-password
SMTP_FROM="Efficiency List <no-reply@example.com>"

# Optional SMS provider. Leave unset to return 501 for phone verification.
# SMS_PROVIDER_URL=
# SMS_PROVIDER_TOKEN=
# SMS_PROVIDER_AUTH_HEADER=Authorization
# SMS_FROM=

# Optional account safety policies.
ACCOUNT_REREGISTRATION_POLICY=allow
AUTH_RISK_SUPPORT_CONTACT=support@example.com
# AUTH_RISK_BLOCKED_IDENTIFIERS=
# AUTH_RISK_BLOCKED_DEVICE_IDS=
# Verification-code send rate limits. Values are per rolling window.
# AUTH_CODE_IDENTIFIER_WINDOW_SEC=3600
# AUTH_CODE_IDENTIFIER_MAX_PER_WINDOW=5
# AUTH_CODE_IP_WINDOW_SEC=300
# AUTH_CODE_IP_MAX_PER_WINDOW=30
# AUTH_CODE_DEVICE_WINDOW_SEC=300
# AUTH_CODE_DEVICE_MAX_PER_WINDOW=10
# Password login lockout after repeated wrong-password attempts.
# AUTH_PASSWORD_MAX_FAILED_ATTEMPTS=5
# AUTH_PASSWORD_LOCK_SEC=900

# Optional document/update integrations.
# LEGAL_DOCS_DIR=docs/legal
# APP_UPDATE_MANIFEST_URL=
# APP_CONTACT_EMAIL=support@example.com
# APP_FEEDBACK_URL=https://example.com/feedback
# APP_SUPPORT_TEXT=
# DIAGNOSTIC_LOG_DIR=server/data/diagnostic-logs

# Optional native/system calendar provider.
# A desktop/native host can export a read-only ICS file and point this variable at it.
# Alternatively, use a read-only HTTPS ICS endpoint.
# SYSTEM_CALENDAR_ICS_FILE=
# SYSTEM_CALENDAR_ICS_URL=
